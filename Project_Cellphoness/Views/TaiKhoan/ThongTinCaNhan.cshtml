@model Project_Cellphoness.Models.TaiKhoan
@using Project_Cellphoness.Helpers

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string hangThanhVien = DiemThuongHelper.LayHangThanhVien(Model.DiemTichLuy);
}

<style>
    .profile-page {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }

    .profile-content {
        flex: 1;
        background: #fff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .profile-header {
        border-bottom: 1px solid #eee;
        padding-bottom: 15px;
        margin-bottom: 25px;
    }

        .profile-header h2 {
            margin: 0 0 5px 0;
            font-size: 20px;
            color: #333;
        }

        .profile-header p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

        .form-group label {
            width: 150px;
            color: #555;
            font-weight: 600;
            text-align: right;
            margin-right: 20px;
        }

    .form-control {
        flex: 1;
        max-width: 400px;
        padding: 10px 15px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #D70018;
            outline: none;
            box-shadow: 0 0 0 3px rgba(215, 0, 24, 0.1);
        }

    .btn-save {
        background: #D70018;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        margin-left: 170px;
        transition: 0.3s;
    }

        .btn-save:hover {
            background: #b50014;
            transform: translateY(-1px);
        }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
        border: 1px solid #c3e6cb;
    }
</style>

<div class="profile-page">
    <!-- GỌI MENU DÙNG CHUNG ĐỒNG BỘ 100% -->
    @Html.Partial("~/Views/TaiKhoan/_MenuTaiKhoan.cshtml")

    <div class="profile-content">
        <div class="profile-header">
            <h2>Hồ sơ của tôi</h2>
            <p>Quản lý thông tin hồ sơ để bảo mật tài khoản</p>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert-success">
                <i class="fa-solid fa-circle-check"></i> @TempData["ThongBao"]
            </div>
        }

        @using (Html.BeginForm("CapNhatThongTin", "TaiKhoan", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="MaTK" value="@Model.MaTK" />

            <div class="form-group">
                <label>Hạng Thành Viên</label>
                <input type="text" class="form-control" value="@hangThanhVien" readonly style="background-color: #fdf5f5; color: #D70018; font-weight: bold; border-color: #ffcdd2; cursor: not-allowed;" />
            </div>

            <div class="form-group">
                <label>Điểm Có Sẵn</label>
                <input type="text" class="form-control" value="@(Model.DiemHienTai ?? 0) Điểm (Dùng để đổi Voucher & Chơi Mini Game)" readonly style="background-color: #f8f9fa; color: #28a745; font-weight: bold; cursor: not-allowed;" />
            </div>

            <hr style="border: 0; border-top: 1px dashed #eee; margin: 20px 0;" />

            <div class="form-group">
                <label>Địa chỉ Email</label>
                <input type="email" class="form-control" value="@Model.Email" readonly style="background-color: #f8f9fa; cursor: not-allowed;" />
            </div>

            <div class="form-group">
                <label>Họ và Tên</label>
                <input type="text" name="HoTen" class="form-control" value="@Model.HoTen" required />
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="text" name="SoDienThoai" class="form-control" value="@Model.SoDienThoai" required />
            </div>

            <button type="submit" class="btn-save">LƯU THAY ĐỔI</button>
        }
    </div>
</div>