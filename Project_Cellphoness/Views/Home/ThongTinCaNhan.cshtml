@model Project_Cellphoness.Models.TaiKhoan
@using Project_Cellphoness.Helpers

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Gọi hàm tính hạng từ Helper
    string hangThanhVien = DiemThuongHelper.LayHangThanhVien(Model.DiemTichLuy);
}

<style>
    .profile-page {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }

    /* MENU TRÁI */
    .profile-sidebar {
        width: 280px;
        background: #fff;
        border-radius: 10px;
        padding: 20px 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        height: fit-content;
    }

    .profile-user-info {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 0 20px 20px 20px;
        border-bottom: 1px solid #eee;
        margin-bottom: 10px;
    }

    .profile-avatar {
        width: 50px;
        height: 50px;
        background: #e9ecef;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: #adb5bd;
    }

    .profile-name {
        font-weight: bold;
        color: #333;
        font-size: 16px;
    }

    /* CSS CHUẨN CHO HUY HIỆU HẠNG THÀNH VIÊN */
    .tier-badge {
        display: inline-block;
        background: linear-gradient(90deg, #ff9a44, #fc6076);
        color: #fff;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 800;
        margin-top: 5px;
        text-transform: uppercase;
        box-shadow: 0 2px 4px rgba(252, 96, 118, 0.3);
    }

    .profile-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .profile-menu li a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            color: #555;
            text-decoration: none;
            font-size: 15px;
            transition: 0.2s;
        }

            .profile-menu li a:hover, .profile-menu li a.active {
                background: #fdf5f5;
                color: var(--red-cps, #D70018);
                border-right: 3px solid var(--red-cps, #D70018);
            }

    /* NỘI DUNG PHẢI */
    .profile-content {
        flex: 1;
        background: #fff;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .profile-header {
        border-bottom: 1px solid #eee;
        padding-bottom: 15px;
        margin-bottom: 25px;
    }

        .profile-header h2 {
            margin: 0 0 5px 0;
            font-size: 20px;
            color: #333;
        }

        .profile-header p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

        .form-group label {
            width: 150px;
            color: #555;
            font-weight: 600;
            text-align: right;
            margin-right: 20px;
        }

    .form-control {
        flex: 1;
        max-width: 400px;
        padding: 10px 15px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: var(--red-cps, #D70018);
            outline: none;
            box-shadow: 0 0 0 3px rgba(215, 0, 24, 0.1);
        }

    .btn-save {
        background: var(--red-cps, #D70018);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
        margin-left: 170px;
        transition: 0.3s;
    }

        .btn-save:hover {
            background: #c50015;
        }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        border: 1px solid #c3e6cb;
    }
</style>

<div class="profile-page">

    <!-- THANH MENU BÊN TRÁI -->
    <div class="profile-sidebar">
        <div class="profile-user-info">
            <div class="profile-avatar">
                <i class="fa-solid fa-user"></i>
            </div>
            <div>
                <div style="font-size: 12px; color: #888;">Tài khoản của</div>
                <div class="profile-name">@Model.HoTen</div>
                <!-- HIỂN THỊ HUY HIỆU HẠNG -->
                <div class="tier-badge"><i class="fa-solid fa-medal"></i> @hangThanhVien</div>
            </div>
        </div>
        <ul class="profile-menu">
            <li>
                <a href="@Url.Action("ThongTinCaNhan", "TaiKhoan")" class="active">
                    <i class="fa-regular fa-id-card"></i> Hồ sơ của tôi
                </a>
            </li>
            <li>
                <a href="@Url.Action("LichSuDonHang", "TaiKhoan")">
                    <i class="fa-solid fa-clipboard-list"></i> Đơn mua của tôi
                </a>
            </li>
            <!-- Thêm menu Ví Voucher (Chuẩn bị cho Giai đoạn 3) -->
            <li>
                <a href="#">
                    <i class="fa-solid fa-ticket"></i> Ví Voucher của tôi
                </a>
            </li>
            <li>
                <a href="@Url.Action("DoiMatKhau", "TaiKhoan")">
                    <i class="fa-solid fa-lock"></i> Đổi mật khẩu
                </a>
            </li>
            <li>
                <a href="@Url.Action("DangXuat", "TaiKhoan")" style="color: #dc3545;">
                    <i class="fa-solid fa-power-off"></i> Đăng xuất
                </a>
            </li>
        </ul>
    </div>

    <!-- KHUNG NHẬP LIỆU BÊN PHẢI -->
    <div class="profile-content">
        <div class="profile-header">
            <h2>Hồ sơ của tôi</h2>
            <p>Quản lý thông tin hồ sơ để bảo mật tài khoản</p>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert-success">
                <i class="fa-solid fa-circle-check"></i> @TempData["ThongBao"]
            </div>
        }

        @using (Html.BeginForm("CapNhatThongTin", "TaiKhoan", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <!-- Mã tài khoản ẩn để truyền về Server -->
            <input type="hidden" name="MaTK" value="@Model.MaTK" />

            <!-- VÙNG HIỂN THỊ ĐIỂM SỐ (Readonly) -->
            <div class="form-group">
                <label>Hạng Thành Viên</label>
                <input type="text" class="form-control" value="@hangThanhVien" readonly style="background-color: #fdf5f5; color: #D70018; font-weight: bold; border-color: #ffcdd2; cursor: not-allowed;" />
            </div>

            <div class="form-group">
                <label>Điểm Có Sẵn</label>
                <input type="text" class="form-control" value="@(Model.DiemHienTai ?? 0) Điểm (Dùng để đổi Voucher)" readonly style="background-color: #f8f9fa; color: #28a745; font-weight: bold; cursor: not-allowed;" />
            </div>

            <hr style="border: 0; border-top: 1px dashed #eee; margin: 20px 0;" />

            <div class="form-group">
                <label>Địa chỉ Email</label>
                <input type="email" class="form-control" value="@Model.Email" readonly style="background-color: #f8f9fa; cursor: not-allowed;" />
            </div>

            <div class="form-group">
                <label>Họ và Tên</label>
                <input type="text" name="HoTen" class="form-control" value="@Model.HoTen" required />
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="text" name="SoDienThoai" class="form-control" value="@Model.SoDienThoai" required />
            </div>

            <button type="submit" class="btn-save">LƯU THAY ĐỔI</button>
        }
    </div>
</div>