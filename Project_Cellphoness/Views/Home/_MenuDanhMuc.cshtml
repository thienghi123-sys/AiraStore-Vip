@model IEnumerable<Project_Cellphoness.Models.HangSanXuat>
@{
    var dbCount = new Project_Cellphoness.Models.CellphonesStoreEntities1();
    int totalAll = dbCount.SanPham.Count(s => s.TrangThai == 1);
}

<style>
    .cat-dropdown-wrap {
        width: 270px;
        padding: 6px 8px;
        background: #fff;
        border-radius: 10px;
    }

    .cat-dropdown-header {
        font-size: 11.5px;
        font-weight: 800;
        color: #888;
        text-transform: uppercase;
        padding: 8px 12px 6px 12px;
        letter-spacing: 0.6px;
        border-bottom: 1px solid #f1f3f5;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .cat-item-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        color: #333;
        text-decoration: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
        margin-bottom: 3px;
    }

    .cat-item-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cat-icon-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #fdf2f3;
        color: #D70018;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        transition: all 0.25s ease;
    }

    .cat-count-badge {
        background: #f1f3f5;
        color: #666;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        transition: all 0.25s ease;
    }

    .cat-item-link:hover {
        background: linear-gradient(90deg, #fce8eb, #fff5f5);
        color: #D70018;
        transform: translateX(6px);
    }

        .cat-item-link:hover .cat-icon-box {
            background: #D70018;
            color: #fff;
            transform: scale(1.1) rotate(-5deg);
            box-shadow: 0 3px 8px rgba(215, 0, 24, 0.25);
        }

        .cat-item-link:hover .cat-count-badge {
            background: #D70018;
            color: #fff;
        }
</style>

<div class="cat-dropdown-wrap">
    <div class="cat-dropdown-header">
        <i class="fa-solid fa-layer-group" style="color: #D70018;"></i> Danh mục hãng điện thoại
    </div>

    <!-- Mục xem tất cả sản phẩm -->
    <a href="@Url.Action("Index", "Home")" class="cat-item-link">
        <div class="cat-item-left">
            <div class="cat-icon-box"><i class="fa-solid fa-border-all"></i></div>
            <span>Tất cả sản phẩm</span>
        </div>
        <span class="cat-count-badge">@totalAll máy</span>
    </a>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            int countSP = dbCount.SanPham.Count(s => s.MaHang == item.MaHang && s.TrangThai == 1);
            string tenLower = (item.TenHang ?? "").ToLower();
            string iconClass = "fa-solid fa-mobile-screen-button";

            if (tenLower.Contains("apple") || tenLower.Contains("iphone"))
            {
                iconClass = "fa-brands fa-apple";
            }
            else if (tenLower.Contains("phụ kiện") || tenLower.Contains("tai nghe"))
            {
                iconClass = "fa-solid fa-headphones";
            }
            else if (tenLower.Contains("samsung") || tenLower.Contains("xiaomi") || tenLower.Contains("oppo") || tenLower.Contains("vivo") || tenLower.Contains("honor"))
            {
                iconClass = "fa-brands fa-android";
            }

            <a href="@Url.Action("SanPhamTheoHang", "Home", new { id = item.MaHang })" class="cat-item-link">
                <div class="cat-item-left">
                    <div class="cat-icon-box"><i class="@iconClass"></i></div>
                    <span>@item.TenHang</span>
                </div>
                <span class="cat-count-badge">@countSP máy</span>
            </a>
        }
    }
</div>