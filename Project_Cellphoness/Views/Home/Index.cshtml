@model PagedList.IPagedList<Project_Cellphoness.Models.SanPham>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<<style>
    /* CSS Slider và các nút cũ giữ nguyên để không vỡ layout */
    .slider-container {
        position: relative;
        max-width: 100%;
        margin: 15px auto;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .mySlides {
        display: none;
    }

        .mySlides img {
            width: 100%;
            height: auto;
            max-height: 350px;
            object-fit: cover;
            display: block;
        }

    .prev, .next {
        cursor: pointer;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 40px;
        height: 60px;
        color: white;
        font-weight: bold;
        font-size: 24px;
        transition: 0.3s ease;
        background-color: rgba(0,0,0,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .next {
        right: 0;
        border-radius: 5px 0 0 5px;
    }

    .prev {
        left: 0;
        border-radius: 0 5px 5px 0;
    }

        .prev:hover, .next:hover {
            background-color: rgba(0,0,0,0.8);
            color: white;
        }

    .fade-anim {
        animation-name: fade;
        animation-duration: 1.5s;
    }

    /* ĐÃ SỬA: Dùng @@keyframes và 0% / 100% để không bị lỗi Razor */
    @@keyframes fade {
        0% {
            opacity: 0.4;
        }

        100% {
            opacity: 1;
        }
    }

    .brand-btn {
        background: #fff;
        border: 1px solid #ddd;
        padding: 8px 15px;
        border-radius: 20px;
        color: #333;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
        white-space: nowrap;
        transition: 0.2s;
    }

        .brand-btn:hover {
            border-color: var(--red-cps);
            color: var(--red-cps);
        }

    .section-title {
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 15px;
        color: var(--text-dark);
        text-transform: uppercase;
    }

    /* KHU VỰC CSS MỚI CHO GIAO DIỆN CHUẨN CELLPHONES */
    .cps-block {
        background-color: #fff;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 30px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    /* ======================================================= */
    /* CSS MỚI CHO THƯƠNG HIỆU NỔI BẬT (QUICK LINKS) */
    /* ======================================================= */
    .brand-list-container {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        padding: 10px 5px;
        scroll-behavior: smooth;
    }

        /* Ẩn thanh cuộn (scrollbar) để giao diện đẹp hơn trên mobile */
        .brand-list-container::-webkit-scrollbar {
            display: none;
        }

    .brand-circle-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: #333;
        min-width: 75px;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        .brand-circle-item:hover {
            transform: translateY(-5px);
        }

    .brand-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background-color: #fff;
        border: 1px solid #e0e0e0;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        transition: 0.3s ease;
        overflow: hidden;
    }

    .brand-circle-item:hover .brand-circle {
        border-color: #D70018;
        box-shadow: 0 5px 15px rgba(215,0,24,0.15);
    }

    .brand-circle img {
        width: 75%;
        height: 75%;
        object-fit: contain;
    }

    /* Nếu không có ảnh logo, dùng chữ in đậm thay thế */
    .brand-text-logo {
        font-weight: 900;
        font-size: 13px;
        text-transform: uppercase;
        color: #555;
    }

    .brand-circle-item:hover .brand-text-logo {
        color: #D70018;
    }

    .brand-name {
        font-size: 13px;
        margin-top: 8px;
        font-weight: 600;
        text-align: center;
        white-space: nowrap;
        color: #444;
    }

    /* ======================================================= */

    .block-goiy {
        background: linear-gradient(180deg, #e3f2fd 0%, #ffffff 100%);
        border: 1px solid #bbdefb;
    }

    .title-goiy {
        text-align: center;
        color: #1976d2;
        font-size: 24px;
        font-weight: 900;
        margin-bottom: 20px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .block-hot {
        background: linear-gradient(180deg, #ffebee 0%, #ffffff 100%);
        border: 1px solid #ffcdd2;
    }

    .title-hot {
        color: #d32f2f;
        font-size: 22px;
        font-weight: 900;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
    }

    .product-card {
        background: #fff;
        border-radius: 10px;
        padding: 12px;
        text-align: center;
        transition: all 0.3s ease;
        border: 1px solid #f0f0f0;
        display: flex;
        flex-direction: column;
        position: relative;
        text-decoration: none;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            border-color: #d70018;
        }

    .product-img {
        width: 100%;
        height: 180px;
        object-fit: contain;
        margin-bottom: 10px;
        transition: 0.3s;
    }

    .product-card:hover .product-img {
        transform: scale(1.05);
    }

    .product-name {
        font-size: 13px;
        font-weight: 600;
        color: #333;
        margin: 0 0 10px 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 36px;
    }

    .product-price {
        color: #D70018;
        font-size: 15px;
        font-weight: bold;
        margin-top: auto;
        margin-bottom: 10px;
    }

    .btn-add-cart {
        background-color: #D70018;
        color: white;
        border: none;
        padding: 8px;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        width: 100%;
        font-size: 13px;
    }

        .btn-add-cart:hover {
            background-color: #b00012;
        }

    .pagination-container ul {
        display: inline-flex;
        padding-left: 0;
        list-style: none;
        border-radius: 5px;
        gap: 5px;
    }

    .pagination-container li {
        display: inline;
    }

        .pagination-container li a, .pagination-container li span {
            color: #333;
            padding: 8px 14px;
            text-decoration: none;
            background-color: #fff;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-weight: bold;
            transition: 0.2s;
        }

            .pagination-container li a:hover {
                background-color: var(--red-cps);
                color: #fff;
                border-color: var(--red-cps);
            }

        .pagination-container li.active span {
            background-color: var(--red-cps);
            color: white;
            border-color: var(--red-cps);
        }
</style>

<!-- SLIDER BANNERS -->
<div class="slider-container">
    @if (ViewBag.ListBanner != null && ((List<Project_Cellphoness.Models.Banner>)ViewBag.ListBanner).Count > 0)
    {
        foreach (var banner in (List<Project_Cellphoness.Models.Banner>)ViewBag.ListBanner)
        {
            <div class="mySlides fade-anim">
                <a href="@(string.IsNullOrEmpty(banner.Link) ? "javascript:void(0)" : banner.Link)">
                    <img src="@banner.HinhAnh" onerror="this.src='https://via.placeholder.com/1200x300?text=Banner'" />
                </a>
            </div>
        }
        <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
        <a class="next" onclick="plusSlides(1)">&#10095;</a>
    }
</div>

<!-- THƯƠNG HIỆU NỔI BẬT (QUICK LINKS) -->
<div class="cps-block" style="background: transparent; box-shadow: none; padding: 0 0 10px 0; margin-bottom: 20px;">
    <h2 class="section-title" style="font-size: 20px;">Thương hiệu nổi bật</h2>
    <div class="brand-list-container">

        <!-- Nút "Tất cả" (Khớp 100% với ảnh tham khảo) -->
        <a href="/" class="brand-circle-item">
            <div class="brand-circle" style="border: 2px solid #D70018;">
                <i class="fa-solid fa-border-all" style="font-size: 24px; color: #D70018;"></i>
            </div>
            <span class="brand-name" style="color: #D70018;">Tất cả</span>
        </a>

        <!-- Danh sách các hãng (Lấy tự động từ CSDL) -->
        <!-- Danh sách các hãng (Lấy tự động từ CSDL) -->
        @if (ViewBag.DanhSachHang != null)
        {
            foreach (var hang in ViewBag.DanhSachHang)
            {
                <a href="/Home/SanPhamTheoHang/@hang.MaHang" class="brand-circle-item">
                    <div class="brand-circle">
                        @if (!string.IsNullOrEmpty(hang.Logo))
                        {
                            <!-- Đã thêm Url.Content để web hiểu dấu ~ -->
                            <img src="@Url.Content(hang.Logo)" alt="@hang.TenHang" onerror="this.src='https://via.placeholder.com/50?text=Loi+Anh'" />
                        }
                        else
                        {
                            <!-- Tự động hiển thị tên nếu Admin chưa tải ảnh Logo lên -->
                            <span class="brand-text-logo">@hang.TenHang</span>
                        }
                    </div>
                    <span class="brand-name">@hang.TenHang</span>
                </a>
            }
        }
    </div>
</div>

<!--  BỘ LỌC TỔNG HỢP: HÃNG (QĐ03) & GIÁ (QĐ04) -->
<div style="background: #fdf5f5; padding: 20px; border-radius: 8px; border: 1px solid #ffcdd2; margin-bottom: 25px;">
    <form id="formLocSanPham" action="@Url.Action("Index", "Home")" method="get">

        <!-- QĐ03: Chọn NHIỀU hãng bằng Checkbox -->
        <div style="margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 15px; align-items: center;">
            <span style="font-weight: bold; color: #d32f2f; min-width: 135px;">
                <i class="fa-solid fa-mobile-screen"></i> Chọn hãng:
            </span>
            @if (ViewBag.DanhSachHang != null)
            {
                foreach (var hang in ViewBag.DanhSachHang)
                {

                    var isChecked = ViewBag.SelectedHangs != null && ((List<int>)ViewBag.SelectedHangs).Contains(hang.MaHang) ? "checked" : "";

                    <label style="cursor: pointer; display: flex; align-items: center; gap: 8px; background: #fff; padding: 6px 12px; border: 1px solid #ddd; border-radius: 20px; font-size: 14px; transition: 0.2s;">
                        <input type="checkbox" name="hangIds" value="@hang.MaHang" @isChecked style="cursor: pointer; width: 16px; height: 16px;">
                        @hang.TenHang
                    </label>
                }
            }
        </div>

        <!-- QĐ04: Khoảng giá thủ công -->
        <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
            <span style="font-weight: bold; color: #d32f2f; min-width: 135px;">
                <i class="fa-solid fa-filter"></i> Chọn khoảng giá:
            </span>

            <div style="display: flex; align-items: center; gap: 8px;">
                <label for="minPrice" style="font-size: 14px;">Từ:</label>
                <input type="number" id="minPrice" name="minPrice" value="@ViewBag.MinPrice" min="0" placeholder="... VNĐ" style="padding: 8px; border: 1px solid #ccc; border-radius: 5px; width: 140px; outline: none;">
            </div>

            <div style="display: flex; align-items: center; gap: 8px;">
                <label for="maxPrice" style="font-size: 14px;">Đến:</label>
                <input type="number" id="maxPrice" name="maxPrice" value="@ViewBag.MaxPrice" min="0" placeholder="... VNĐ" style="padding: 8px; border: 1px solid #ccc; border-radius: 5px; width: 140px; outline: none;">
            </div>

            <button type="submit" class="brand-btn" style="background: var(--red-cps); color: white; border-color: var(--red-cps); padding: 8px 25px;">
                ÁP DỤNG LỌC
            </button>
            <a href="/" class="brand-btn" style="background: #fff; color: #333; padding: 8px 15px;">
                <i class="fa-solid fa-rotate-right"></i> Làm mới
            </a>
        </div>
    </form>
</div>


<!--  KHỐI 1: GỢI Ý CHO BẠN  -->
@if (ViewBag.GoiYChoBan != null && ((List<Project_Cellphoness.Models.SanPham>)ViewBag.GoiYChoBan).Count > 0)
{
    <div class="cps-block block-goiy">
        <div class="title-goiy"><i class="fa-solid fa-wand-magic-sparkles"></i> GỢI Ý CHO BẠN</div>
        <div class="product-grid">
            @foreach (var sp in (List<Project_Cellphoness.Models.SanPham>)ViewBag.GoiYChoBan)
            {
                <div class="product-card">
                    <a href="/Home/Details/@sp.MaSP" style="text-decoration:none; color:inherit;">
                        <img src="@sp.HinhAnh" class="product-img" onerror="this.src='https://via.placeholder.com/200?text=No+Image'" />
                        <h3 class="product-name">@sp.TenSP</h3>
                    </a>
                    <p class="product-price">@String.Format("{0:0,0}", sp.GiaBan).Replace(",", ".") đ</p>

                    <!-- QĐ05: Ẩn nút "Thêm vào giỏ" nếu tồn kho = 0 -->
                    @if (sp.SoLuongTon > 0)
                    {
                        <a href="@Url.Action("ThemGioHang", "GioHang", new { iMaSP = sp.MaSP, strURL = Request.Url.ToString() })" class="btn-add-cart" style="text-decoration:none; display:block;">
                            <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ
                        </a>
                    }
                    else
                    {
                        <button class="btn-add-cart" style="background-color: #999; cursor: not-allowed; text-decoration:none; display:block;" disabled title="Sản phẩm hiện đang hết hàng">
                            <i class="fa-solid fa-box-open"></i> Tạm hết hàng
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

<!-- KHỐI 2: APPLE CHÍNH HÃNG (NỀN ĐỎ DEAL SỐC)  -->
@if (ViewBag.AppleList != null && ((List<Project_Cellphoness.Models.SanPham>)ViewBag.AppleList).Count > 0)
{
    <div class="cps-block block-hot">
        <div class="title-hot"><i class="fa-brands fa-apple"></i> APPLE CHÍNH HÃNG - DEAL SỐC</div>
        <div class="product-grid">
            @foreach (var sp in (List<Project_Cellphoness.Models.SanPham>)ViewBag.AppleList)
            {
                <div class="product-card">
                    <div style="position: absolute; top: -5px; left: -5px; background: #d70018; color: white; padding: 3px 8px; border-radius: 5px; font-size: 11px; font-weight: bold; box-shadow: 2px 2px 5px rgba(0,0,0,0.2); z-index: 2;">
                        Giảm sốc
                    </div>
                    <a href="/Home/Details/@sp.MaSP" style="text-decoration:none; color:inherit;">
                        <img src="@sp.HinhAnh" class="product-img" onerror="this.src='https://via.placeholder.com/200?text=No+Image'" />
                        <h3 class="product-name">@sp.TenSP</h3>
                    </a>
                    <p class="product-price">@String.Format("{0:0,0}", sp.GiaBan).Replace(",", ".") đ</p>

                    <!-- QĐ05: Ẩn nút "Thêm vào giỏ" nếu tồn kho = 0 -->
                    @if (sp.SoLuongTon > 0)
                    {
                        <a href="@Url.Action("ThemGioHang", "GioHang", new { iMaSP = sp.MaSP, strURL = Request.Url.ToString() })" class="btn-add-cart" style="text-decoration:none; display:block;">
                            <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ
                        </a>
                    }
                    else
                    {
                        <button class="btn-add-cart" style="background-color: #999; cursor: not-allowed; text-decoration:none; display:block;" disabled title="Sản phẩm hiện đang hết hàng">
                            <i class="fa-solid fa-box-open"></i> Tạm hết hàng
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

<!--  KHỐI 3: DANH SÁCH SẢN PHẨM TỔNG HỢP   -->
<div class="cps-block" style="background: #fff;">
    <div class="section-title"><i class="fa-solid fa-layer-group"></i> TẤT CẢ SẢN PHẨM</div>
    <div class="product-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var sp in Model)
            {
                <div class="product-card">
                    <a href="/Home/Details/@sp.MaSP" style="text-decoration:none; color:inherit;">
                        <img src="@sp.HinhAnh" class="product-img" onerror="this.src='https://via.placeholder.com/200?text=No+Image'" />
                        <h3 class="product-name">@sp.TenSP</h3>
                    </a>
                    <p class="product-price">@String.Format("{0:0,0}", sp.GiaBan).Replace(",", ".") đ</p>

                    <!-- QĐ05: Ẩn nút "Thêm vào giỏ" nếu tồn kho = 0 -->
                    @if (sp.SoLuongTon > 0)
                    {
                        <a href="@Url.Action("ThemGioHang", "GioHang", new { iMaSP = sp.MaSP, strURL = Request.Url.ToString() })" class="btn-add-cart" style="text-decoration:none; display:block;">
                            <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ
                        </a>
                    }
                    else
                    {
                        <button class="btn-add-cart" style="background-color: #999; cursor: not-allowed; text-decoration:none; display:block;" disabled title="Sản phẩm hiện đang hết hàng">
                            <i class="fa-solid fa-box-open"></i> Tạm hết hàng
                        </button>
                    }
                </div>
            }
        }
        else
        {
            <p style="grid-column: span 5; text-align:center; padding:20px; font-weight: bold; color: #666;">Không tìm thấy sản phẩm nào.</p>
        }
    </div>

    <!-- Phân trang -->
    <div class="pagination-container" style="text-align: center; margin-top: 30px;">
        <span style="color: #666; font-size: 14px; display: block; margin-bottom: 10px;">
            Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount
        </span>
        <div class="pager">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice }),
                new PagedListRenderOptions { LinkToFirstPageFormat = "« Đầu", LinkToPreviousPageFormat = "‹ Trước", LinkToNextPageFormat = "Sau ›", LinkToLastPageFormat = "Cuối »", DisplayLinkToFirstPage = PagedListDisplayMode.IfNeeded, DisplayLinkToLastPage = PagedListDisplayMode.IfNeeded })
        </div>
    </div>
</div>

<script>
    // 1. Script chạy Banner Slider
    let slideIndex = 0; let timer;
    document.addEventListener("DOMContentLoaded", function () { showSlides(); });

    function showSlides() {
        let i; let slides = document.getElementsByClassName("mySlides");
        if (slides.length === 0) return;
        for (i = 0; i < slides.length; i++) { slides[i].style.display = "none"; }
        slideIndex++; if (slideIndex > slides.length) { slideIndex = 1 }
        slides[slideIndex - 1].style.display = "block";
        timer = setTimeout(showSlides, 5000);
    }

    function plusSlides(n) {
        clearTimeout(timer); slideIndex += n - 1;
        let slides = document.getElementsByClassName("mySlides");
        if (slideIndex < 0) { slideIndex = slides.length - 1; }
        else if (slideIndex >= slides.length) { slideIndex = 0; }
        showSlides();
    }

    // 2. Script bắt lỗi Nhập giá trị lọc (QĐ04)
    document.getElementById('formLocSanPham').addEventListener('submit', function (event) {

        var minInput = document.getElementById('minPrice').value;
        var maxInput = document.getElementById('maxPrice').value;


        if (minInput !== "" && maxInput !== "") {
            var minPrice = parseFloat(minInput);
            var maxPrice = parseFloat(maxInput);

            // Kiểm tra quy định QĐ04
            if (maxPrice < minPrice) {

                event.preventDefault();

                alert('Lỗi nhập liệu: Mức giá "Đến" bắt buộc phải lớn hơn hoặc bằng mức giá "Từ"!');
            }
        }
    });
</script>