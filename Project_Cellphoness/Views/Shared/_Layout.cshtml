<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hệ thống bán lẻ Điện Thoại</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- THƯ VIỆN LORDICON SIÊU MƯỢT (Gọi trực tiếp, không cần Node.js) -->
    <script src="https://cdn.lordicon.com/lordicon.js"></script>

    <style>
        :root {
            --red-cps: #D70018; /* Màu đỏ đặc trưng */
            --bg-gray: #f4f6f8; /* Màu nền xám nhạt */
            --text-dark: #333333;
        }

        body {
            background-color: var(--bg-gray);
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
            padding: 0;
        }

        /* ----- HEADER ----- */
        .header {
            background-color: var(--red-cps);
            color: white;
            padding: 10px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 10px;
        }

        /* Logo */
        .logo {
            font-size: 22px;
            font-weight: 900;
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* HIỆU ỨNG DROPDOWN */
        .header-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-menu-content {
            position: absolute;
            top: 130%;
            left: 0;
            background-color: #fff;
            min-width: 240px;
            box-shadow: 0px 8px 25px rgba(0,0,0,0.18);
            border-radius: 10px;
            padding: 10px 0;
            z-index: 1001;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

            .dropdown-menu-content::before {
                content: "";
                position: absolute;
                top: -8px;
                left: 20px;
                border-width: 0 8px 8px 8px;
                border-style: solid;
                border-color: transparent transparent #fff transparent;
            }

        .header-dropdown:hover .dropdown-menu-content {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            top: 110%;
        }

        .dropdown-item {
            color: var(--text-dark);
            padding: 10px 18px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
            transition: all 0.2s ease;
            font-weight: 600;
        }

            .dropdown-item:hover {
                background-color: #fce8eb;
                color: var(--red-cps);
                padding-left: 23px;
            }

            .dropdown-item i {
                width: 20px;
                text-align: center;
                font-size: 17px;
                color: #555;
                transition: transform 0.2s ease;
            }

            .dropdown-item:hover i {
                color: var(--red-cps);
                transform: scale(1.15);
            }

        /* Mục Mini Game màu vàng nổi bật trong Dropdown */
        @@keyframes wiggleGameIcon {
            0%, 100% {
                transform: rotate(0deg);
            }

            25% {
                transform: rotate(-12deg) scale(1.1);
            }

            75% {
                transform: rotate(12deg) scale(1.1);
            }
        }

        .dropdown-item-game {
            background: linear-gradient(135deg, #FFD700, #FF8C00) !important;
            color: #fff !important;
            font-weight: 800 !important;
            margin: 5px 10px;
            border-radius: 8px;
            padding: 10px 14px !important;
            box-shadow: 0 3px 10px rgba(255, 140, 0, 0.35);
        }

            .dropdown-item-game i {
                color: #fff !important;
                animation: wiggleGameIcon 1.5s infinite ease-in-out;
            }

            .dropdown-item-game:hover {
                background: linear-gradient(135deg, #FFC300, #FF6B00) !important;
                color: #fff !important;
                transform: scale(1.03);
            }

        .btn-category {
            background-color: rgba(255,255,255,0.2);
            color: white;
            padding: 10px 15px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-category:hover {
                background-color: rgba(255,255,255,0.3);
            }

        /* ======================================================== */
        /* CSS CHO THANH TÌM KIẾM & DROPDOWN GỢI Ý (AUTO-SUGGEST) */
        /* ======================================================== */
        .search-container {
            position: relative;
            flex: 1;
            max-width: 430px;
            margin: 0 15px;
        }

        .search-box {
            display: flex;
            background: white;
            border-radius: 10px;
            padding: 2px 10px;
            align-items: center;
            height: 38px;
            width: 100%;
            box-sizing: border-box;
        }

            .search-box input {
                border: none;
                outline: none;
                width: 100%;
                padding: 5px;
                font-size: 14px;
            }

            .search-box button {
                background: none;
                border: none;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 5px;
            }

        .search-suggest-box {
            position: absolute;
            top: 115%;
            left: 0;
            width: 100%;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0px 10px 25px rgba(0,0,0,0.2);
            z-index: 1002;
            display: none;
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #eee;
        }

        .suggest-header {
            padding: 10px 15px;
            background: #f8f9fa;
            font-size: 13px;
            font-weight: bold;
            color: #555;
            border-bottom: 1px solid #f0f0f0;
        }

        .suggest-item {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            border-bottom: 1px solid #f0f0f0;
            text-decoration: none;
            color: #333;
            transition: 0.2s;
        }

            .suggest-item:hover {
                background-color: #fce8eb;
            }

            .suggest-item:last-child {
                border-bottom: none;
            }

        .suggest-img {
            width: 45px;
            height: 45px;
            object-fit: contain;
            margin-right: 12px;
        }

        .suggest-info {
            display: flex;
            flex-direction: column;
        }

        .suggest-name {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .suggest-price {
            font-size: 13px;
            color: #D70018;
            font-weight: bold;
        }

        .header-items {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .header-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: white;
            text-decoration: none;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            padding: 5px 10px;
        }

            .header-btn i {
                font-size: 20px;
                margin-bottom: 3px;
            }

            .header-btn:hover {
                background-color: rgba(255,255,255,0.2);
                border-radius: 8px;
            }

        .user-dropdown .dropdown-menu-content {
            left: auto;
            right: 0;
            min-width: 240px;
        }

            .user-dropdown .dropdown-menu-content::before {
                left: auto;
                right: 25px;
            }

        .cart-wrapper {
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -5px;
            right: 5px;
            background: #FFB800;
            color: var(--text-dark);
            padding: 2px 6px;
            border-radius: 50%;
            font-size: 11px;
            font-weight: bold;
            z-index: 10;
        }

        .main-content {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 10px;
            min-height: 70vh;
        }

        .cps-footer {
            background-color: #f8f9fa;
            padding: 40px 0 20px 0;
            border-top: 1px solid #eee;
            margin-top: 50px;
        }

        .cps-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: space-between;
        }

        .cps-col {
            flex: 1;
            min-width: 250px;
        }

            .cps-col h4 {
                font-size: 16px;
                color: #333;
                margin-bottom: 15px;
                font-weight: bold;
            }

            .cps-col p, .cps-col a {
                font-size: 13px;
                color: #444;
                text-decoration: none;
                margin-bottom: 10px;
                display: block;
                line-height: 1.5;
            }

                .cps-col a:hover {
                    color: var(--red-cps);
                }

        .cps-social-icons i {
            font-size: 24px;
            margin-right: 10px;
            color: #555;
            transition: 0.3s;
        }

            .cps-social-icons i.fa-youtube:hover {
                color: #ff0000;
            }

            .cps-social-icons i.fa-facebook:hover {
                color: #1877f2;
            }

        .cps-partner-badge {
            display: inline-block;
            background: #D70018;
            color: white;
            padding: 5px 10px;
            border-radius: 4px;
            font-weight: bold;
            margin-bottom: 10px;
            font-size: 14px;
        }

        /* ======================================================== */
        /* WIDGET CHAT & HIỆU ỨNG TỎA SÓNG ĐỒNG BỘ */
        /* ======================================================== */
        .chat-widget-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 9999;
            align-items: center;
        }

        .chat-btn {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            transition: transform 0.3s;
            text-decoration: none;
            border: none;
            cursor: pointer;
            padding: 0;
        }

            .chat-btn:hover {
                transform: scale(1.15);
            }

        .scroll-top-btn {
            background-color: #333;
            color: white;
            font-size: 20px;
            display: none;
        }

        /* Tỏa sóng màu xanh cho Zalo & Messenger */
        @@keyframes pulseBlue {
            0% {
                box-shadow: 0 0 0 0 rgba(0, 104, 255, 0.7);
            }

            70% {
                box-shadow: 0 0 0 15px rgba(0, 104, 255, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(0, 104, 255, 0);
            }
        }

        /* Tỏa sóng màu đỏ cho nút AI AiraStore */
        @@keyframes pulseRed {
            0% {
                box-shadow: 0 0 0 0 rgba(215, 0, 24, 0.7);
            }

            70% {
                box-shadow: 0 0 0 15px rgba(215, 0, 24, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(215, 0, 24, 0);
            }
        }

        .zalo-btn {
            background-color: #0068ff;
            animation: pulseBlue 2s infinite;
        }

        .mess-btn {
            background: linear-gradient(45deg, #00B2FF, #006AFF);
            color: white;
            font-size: 28px;
            animation: pulseBlue 2s infinite;
        }

        /* ======================================================== */
        /* NÚT AI LOGO SHOP & POPUP TOOLTIP 24/7 */
        /* ======================================================== */
        .ai-widget-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .ai-btn {
            background: #fff;
            border: 2px solid var(--red-cps);
            animation: pulseRed 2s infinite;
            overflow: hidden;
        }

            .ai-btn img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 50%;
            }

        /* Popup nhỏ: "Giải đáp mọi thắc mắc 24/7 ở đây" */
        .ai-tooltip-popup {
            position: absolute;
            right: 70px;
            background: #fff;
            color: var(--red-cps);
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            white-space: nowrap;
            box-shadow: 0 4px 15px rgba(215, 0, 24, 0.2);
            border: 1.5px solid var(--red-cps);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            animation: floatTooltip 2.5s ease-in-out infinite;
            transition: all 0.2s ease;
        }

            .ai-tooltip-popup:hover {
                background: var(--red-cps);
                color: #fff;
            }

            .ai-tooltip-popup::after {
                content: "";
                position: absolute;
                right: -7px;
                top: 50%;
                transform: translateY(-50%) rotate(45deg);
                width: 10px;
                height: 10px;
                background: #fff;
                border-top: 1.5px solid var(--red-cps);
                border-right: 1.5px solid var(--red-cps);
                transition: background 0.2s ease;
            }

            .ai-tooltip-popup:hover::after {
                background: var(--red-cps);
            }

        @@keyframes floatTooltip {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-4px);
            }
        }

        /* ======================================================== */
        /* KHUNG HỘP THOẠI CHAT AI */
        /* ======================================================== */
        .ai-chat-box {
            position: fixed;
            bottom: 100px;
            right: 30px;
            width: 350px;
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            display: none;
            flex-direction: column;
            z-index: 10000;
            overflow: hidden;
            border: 1px solid #eee;
            transform-origin: bottom right;
            animation: scaleUp 0.3s ease-out forwards;
        }

        @@keyframes scaleUp {
            0% {
                opacity: 0;
                transform: scale(0.5);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        .ai-chat-header {
            background: linear-gradient(45deg, #D70018, #ff4b2b);
            color: #fff;
            padding: 12px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
        }

        .ai-chat-close {
            cursor: pointer;
            font-size: 18px;
            transition: 0.2s;
        }

            .ai-chat-close:hover {
                transform: rotate(90deg);
            }

        .ai-chat-body {
            padding: 15px;
            height: 350px;
            overflow-y: auto;
            background: #fdfdfd;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .ai-msg-bubble {
            max-width: 85%;
            padding: 12px 16px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.5;
            word-wrap: break-word;
        }

        .msg-user {
            background: var(--red-cps);
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 2px;
        }

        .msg-bot {
            background: #f1f3f5;
            color: #333;
            align-self: flex-start;
            border-bottom-left-radius: 2px;
        }

        .ai-product-card {
            display: flex;
            align-items: center;
            background: #fff;
            border: 1px solid #ffcccc;
            border-radius: 10px;
            padding: 10px;
            margin-top: 5px;
            text-decoration: none;
            color: #333;
            box-shadow: 0 2px 5px rgba(215, 0, 24, 0.1);
            transition: 0.2s;
        }

            .ai-product-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(215, 0, 24, 0.2);
                border-color: var(--red-cps);
            }

        .ai-product-img {
            width: 50px;
            height: 50px;
            object-fit: contain;
            margin-right: 10px;
        }

        .ai-product-info {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .ai-product-name {
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 3px;
        }

        .ai-product-price {
            font-size: 13px;
            color: var(--red-cps);
            font-weight: 800;
        }

        .ai-chat-footer {
            padding: 12px;
            border-top: 1px solid #eaeaea;
            display: flex;
            gap: 10px;
            background: #fff;
        }

            .ai-chat-footer input {
                flex: 1;
                padding: 12px 15px;
                border: 1px solid #ddd;
                border-radius: 25px;
                outline: none;
                font-size: 14px;
                transition: 0.3s;
            }

                .ai-chat-footer input:focus {
                    border-color: #ff4b2b;
                }

            .ai-chat-footer button {
                background: none;
                border: none;
                color: #ff4b2b;
                font-size: 22px;
                cursor: pointer;
                transition: 0.2s;
            }

                .ai-chat-footer button:hover {
                    transform: scale(1.1);
                }

        /* ======================================================== */
        /* CSS NÚT NỔI & POPUP ĐIỂM DANH TÍCH LŨY 7 NGÀY LIÊN TỤC */
        /* ======================================================== */
        .floating-checkin-wrapper {
            position: fixed;
            bottom: 30px;
            left: 30px;
            z-index: 9998;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .floating-checkin-btn {
            background: linear-gradient(135deg, #D70018, #ff6a00);
            color: #fff;
            border: 2.5px solid #FFD700;
            border-radius: 35px;
            padding: 10px 18px;
            font-weight: 800;
            font-size: 13.5px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(215, 0, 24, 0.35);
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
            animation: pulseCheckinBtn 2s infinite;
        }

            .floating-checkin-btn:hover {
                transform: scale(1.08);
            }

            .floating-checkin-btn i {
                font-size: 20px;
                color: #FFD700;
            }

        @@keyframes pulseCheckinBtn {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 184, 0, 0.7);
            }

            70% {
                box-shadow: 0 0 0 14px rgba(255, 184, 0, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(255, 184, 0, 0);
            }
        }

        /* Nhãn đỏ "Hãy thử ngay" kèm bàn tay chỉ ở góc dưới */
        .floating-hand-prompt {
            background: #fff;
            color: #D70018;
            border: 1.5px solid #D70018;
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 12.5px;
            font-weight: 900;
            text-decoration: none;
            box-shadow: 0 4px 12px rgba(215,0,24,0.2);
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            animation: bounceHandLeft 1.1s infinite ease-in-out;
        }

            .floating-hand-prompt:hover {
                background: #D70018;
                color: #fff;
            }

        @@keyframes bounceHandLeft {
            0%, 100% {
                transform: translateX(0);
            }

            50% {
                transform: translateX(-6px);
            }
        }

        /* Khung Modal Điểm danh 7 ngày */
        .checkin-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.65);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 20000;
            backdrop-filter: blur(4px);
        }

        .checkin-modal-card {
            background: #fff;
            width: 540px;
            max-width: 94%;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            animation: checkinZoomIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @@keyframes checkinZoomIn {
            0% {
                opacity: 0;
                transform: scale(0.6) translateY(30px);
            }

            100% {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .checkin-header {
            background: linear-gradient(135deg, #D70018, #ff512f);
            color: #fff;
            padding: 22px 25px;
            position: relative;
            text-align: center;
        }

            .checkin-header h3 {
                margin: 0 0 6px 0;
                font-size: 22px;
                font-weight: 900;
                text-transform: uppercase;
            }

            .checkin-header p {
                margin: 0;
                font-size: 13px;
                opacity: 0.92;
            }

        .checkin-close {
            position: absolute;
            top: 15px;
            right: 18px;
            font-size: 22px;
            cursor: pointer;
            color: #fff;
            transition: 0.2s;
        }

            .checkin-close:hover {
                transform: rotate(90deg);
            }

        .checkin-body {
            padding: 25px;
            text-align: center;
        }

        .streak-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .streak-day-box {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 12px 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            position: relative;
            transition: 0.25s;
        }

            .streak-day-box.day-sunday {
                grid-column: span 2;
                background: linear-gradient(135deg, #fff8e1, #ffecb3);
                border-color: #ffc107;
            }

            .streak-day-box.claimed {
                background: #fce8eb;
                border-color: #D70018;
                color: #D70018;
            }

            .streak-day-box.today-target {
                border-color: #ff9800;
                background: #fff3e0;
                transform: scale(1.05);
                box-shadow: 0 4px 12px rgba(255, 152, 0, 0.25);
            }

        .day-label {
            font-size: 12.5px;
            font-weight: 800;
            color: #444;
        }

        .day-pts {
            font-size: 15px;
            font-weight: 900;
            color: #D70018;
        }

        .btn-claim-checkin {
            background: linear-gradient(135deg, #D70018, #ff4b2b);
            color: #fff;
            border: none;
            padding: 14px 40px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 6px 18px rgba(215, 0, 24, 0.35);
            transition: 0.3s;
            width: 100%;
        }

            .btn-claim-checkin:hover {
                transform: translateY(-2px);
            }

            .btn-claim-checkin:disabled {
                background: #adb5bd;
                box-shadow: none;
                cursor: not-allowed;
            }
    </style>
</head>
<body>

    <header class="header">
        <div class="header-container">
            <a href="/" class="logo">
                <i class="fa-solid fa-mobile-screen-button"></i> AiraStore
            </a>

            <div class="header-dropdown" style="margin-left: 15px;">
                <div class="btn-category">
                    <i class="fa-solid fa-bars"></i> Danh mục
                </div>
                <div class="dropdown-menu-content">
                    @Html.Action("MenuDanhMuc", "Home")
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- KHUNG TÌM KIẾM THÔNG MINH AUTO-SUGGEST -->
            <!-- ======================================================== -->
            <div class="search-container">
                <form action="@Url.Action("TimKiem", "Home")" method="get" class="search-box">
                    <input type="text" name="tuKhoa" id="txtSearchMain" placeholder="Bạn cần tìm gì hôm nay?" autocomplete="off" required oninput="goiYTimKiemSmart()" />
                    <button type="submit">
                        <lord-icon src="https://cdn.lordicon.com/fkdzyfle.json"
                                   trigger="hover"
                                   colors="primary:#333333"
                                   style="width:24px;height:24px">
                        </lord-icon>
                    </button>
                </form>

                <!-- Hộp Dropdown Gợi Ý -->
                <div id="search-suggest-box" class="search-suggest-box"></div>
            </div>

            <div class="header-items">
                <a href="@Url.Action("TinTuc", "Home")" class="header-btn">
                    <i class="fa-regular fa-newspaper"></i>
                    <span>Tin tức</span>
                </a>

                <!-- NÚT YÊU THÍCH KÈM BADGE HIỂN THỊ SỐ LƯỢNG GIỐNG GIỎ HÀNG -->
                @{
                    int soLuongYeuThich = 0;
                    var tkYeuThich = Session["TaiKhoan"] as Project_Cellphoness.Models.TaiKhoan;
                    string tenCookieYT = tkYeuThich != null ? "YeuThichCookie_" + tkYeuThich.MaTK : "YeuThichCookie";
                    var cookieYTHeader = Request.Cookies[tenCookieYT] ?? Request.Cookies["YeuThichCookie"];

                    if (cookieYTHeader != null && !string.IsNullOrEmpty(cookieYTHeader.Value))
                    {
                        var dsIdTim = cookieYTHeader.Value
                            .Split(new char[] { ',', '-' }, StringSplitOptions.RemoveEmptyEntries)
                            .Distinct()
                            .ToList();
                        soLuongYeuThich = dsIdTim.Count;
                    }
                }

                <a href="@Url.Action("Index", "YeuThich")" class="header-btn cart-wrapper">
                    <i class="fa-solid fa-heart"></i>
                    <span>Yêu thích</span>
                    <span class="cart-badge" id="wishlistBadgeCount">@soLuongYeuThich</span>
                </a>

                @Html.Action("GioHangPartial", "GioHang")

                @{
                    var taiKhoan = Session["TaiKhoan"] as Project_Cellphoness.Models.TaiKhoan;
                }

                @if (taiKhoan == null)
                {
                    <a href="/TaiKhoan/DangNhap" class="header-btn">
                        <i class="fa-regular fa-circle-user"></i>
                        <span>Đăng nhập</span>
                    </a>
                }
                else
                {
                    // Truy vấn ngầm qua CSDL để lấy thông tin Avatar mới nhất tránh lệch Session cũ
                    {
                        Project_Cellphoness.Models.CellphonesStoreEntities1 dbLayout = new Project_Cellphoness.Models.CellphonesStoreEntities1();
                        var freshUser = dbLayout.TaiKhoan.Find(taiKhoan.MaTK);
                        if (freshUser != null) { taiKhoan = freshUser; }
                    }

                    <div class="header-dropdown user-dropdown">
                        <!-- KHUNG NÚT HEADER CÓ HIỂN THỊ AVATAR TRÒN -->
                        <div class="header-btn" style="padding-top: 2px; display: flex; align-items: center; gap: 6px;">
                            @if (!string.IsNullOrEmpty(taiKhoan.Avatar))
                            {
                                <img src="@Url.Content(taiKhoan.Avatar)" alt="Avatar" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 1.5px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.2);" />
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-user" style="font-size: 22px;"></i>
                            }
                            <span style="font-weight: bold;">
                                @taiKhoan.HoTen.Split(' ').Last() <i class="fa-solid fa-chevron-down" style="font-size: 10px; margin-left: 2px;"></i>
                            </span>
                        </div>

                        <!-- MENU XỔ XUỐNG ĐỒNG BỘ ĐẦY ĐỦ CÁC TÍNH NĂNG -->
                        <div class="dropdown-menu-content">
                            <a href="@Url.Action("ThongTinCaNhan", "TaiKhoan")" class="dropdown-item">
                                <i class="fa-regular fa-id-card"></i> Hồ sơ của tôi
                            </a>
                            <a href="@Url.Action("LichSuDonHang", "TaiKhoan")" class="dropdown-item">
                                <i class="fa-solid fa-clipboard-list"></i> Đơn mua của tôi
                            </a>
                            <a href="@Url.Action("ViVoucher", "DoiThuong")" class="dropdown-item">
                                <i class="fa-solid fa-ticket"></i> Ví Voucher của tôi
                            </a>
                            <a href="@Url.Action("Index", "DoiThuong")" class="dropdown-item">
                                <i class="fa-solid fa-gift"></i> Đổi thêm Voucher
                            </a>

                            <!-- NÚT MINI GAME MÀU VÀNG NỔI BẬT DƯỚI MỤC ĐỔI VOUCHER -->
                            <a href="@Url.Action("MiniGame", "TaiKhoan")" class="dropdown-item dropdown-item-game">
                                <i class="fa-solid fa-gamepad"></i> Mini Game X2 Điểm
                                <span style="margin-left:auto; background:#D70018; color:#fff; font-size:10px; padding:2px 6px; border-radius:8px; font-weight:900;">HOT</span>
                            </a>

                            <!-- NÚT MỞ POPUP ĐIỂM DANH TÍCH LŨY 7 NGÀY -->
                            <a href="javascript:void(0)" onclick="openDailyCheckInModal()" class="dropdown-item" style="color: #e65100; font-weight: 700;">
                                <i class="fa-solid fa-calendar-check" style="color: #ff6d00;"></i> Điểm danh nhận điểm
                            </a>

                            <a href="@Url.Action("DoiMatKhau", "TaiKhoan")" class="dropdown-item">
                                <i class="fa-solid fa-lock"></i> Đổi mật khẩu
                            </a>
                            <div style="border-top: 1px solid #eee; margin: 5px 0;"></div>
                            <a href="@Url.Action("DangXuat", "TaiKhoan")" class="dropdown-item" style="color: #D70018;">
                                <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </header>

    <div class="main-content">
        @RenderBody()
    </div>

    <footer class="cps-footer">
        <div class="cps-container">
            <div class="cps-col">
                <h4>Tổng đài hỗ trợ miễn phí</h4>
                <p>Mua hàng - bảo hành <strong>1800.2097</strong> (7h30 - 22h00)</p>
                <p>Khiếu nại <strong>1800.2063</strong> (8h00 - 21h30)</p>
                <h4 style="margin-top: 20px;">Phương thức thanh toán</h4>
                <div style="font-size: 28px; color: #555;">
                    <i class="fa-brands fa-apple-pay"></i>
                    <i class="fa-brands fa-cc-visa"></i>
                    <i class="fa-brands fa-cc-mastercard"></i>
                    <i class="fa-brands fa-cc-paypal"></i>
                </div>
            </div>
            <div class="cps-col">
                <h4>Thông tin và chính sách</h4>
                <a href="#">Mua hàng và thanh toán Online</a>
                <a href="#">Chính sách giao hàng</a>
                <a href="#">Chính sách đổi trả</a>
                <a href="#">Trung tâm bảo hành chính hãng</a>
            </div>
            <div class="cps-col">
                <h4>Dịch vụ và thông tin khác</h4>
                <a href="#">Khách hàng doanh nghiệp (B2B)</a>
                <a href="#">Quy chế hoạt động</a>
                <a href="#">Chính sách Bảo mật</a>
                <h4 style="margin-top: 20px;">App AiraStore</h4>
                <div style="background: #fff; padding: 10px; border-radius: 5px; display: inline-block; border: 1px solid #ddd;">
                    <i class="fa-solid fa-qrcode" style="font-size: 60px; color: #D70018;"></i>
                </div>
            </div>
            <div class="cps-col">
                <h4>Kết nối với chúng tôi</h4>
                <div class="cps-social-icons">
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                </div>
                <h4 style="margin-top: 20px;">Hệ thống thành viên</h4>
                <div class="cps-partner-badge">dienthoaivui</div>
                <div class="cps-partner-badge" style="background: #000;">careS</div>
            </div>
        </div>

        <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 13px; color: #666;">
            <p style="margin: 0;">&copy; @DateTime.Now.Year - Aira-shiratorri is the best. Hệ thống bán lẻ điện thoại siu cấp vip pro.</p>
        </div>
    </footer>

    <!-- ======================================================== -->
    <!-- KHU VỰC NÚT NỔI VÀ KHUNG CHAT AI (GÓC DƯỚI PHẢI) -->
    <!-- ======================================================== -->
    @{
        string linkLogoAI = "https://i.postimg.cc/Z9Y0cNkC/548a4112b9687cca06cdffe9.png";
    }

    <div class="chat-widget-container no-print">
        <button id="btnScrollTop" class="chat-btn scroll-top-btn" onclick="scrollToTop()" title="Lên đầu trang">
            <i class="fa-solid fa-arrow-up"></i>
        </button>

        <!-- Cụm nút AI kèm Popup nhỏ 24/7 -->
        <div class="ai-widget-wrapper">
            <div id="aiTooltipPopup" class="ai-tooltip-popup" onclick="toggleAIChat()">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Giải đáp mọi thắc mắc 24/7 ở đây
            </div>
            <button onclick="toggleAIChat()" class="chat-btn ai-btn" title="Hỏi AI Tư Vấn">
                <img src="@linkLogoAI" alt="AI AiraStore" onerror="this.src='https://cdn-icons-png.flaticon.com/512/4712/4712035.png'" />
            </button>
        </div>

        <a href="https://www.facebook.com/share/15yEeuiapDZ/" target="_blank" class="chat-btn mess-btn">
            <i class="fa-brands fa-facebook-messenger"></i>
        </a>
        <a href="https://zalo.me/0868749948" target="_blank" class="chat-btn zalo-btn">
            <img src="https://inhoangha.com/uploads/tai-zalo-logo-vector.jpg" style="width: 35px; border-radius: 50%;" />
        </a>
    </div>

    <!-- Khung giao diện Chat AI -->
    <div id="aiChatBox" class="ai-chat-box no-print">
        <div class="ai-chat-header">
            <span style="display: flex; align-items: center; gap: 8px;">
                <img src="@linkLogoAI" style="width: 30px; height: 30px; border-radius: 50%; background: #fff; border: 1.5px solid #fff; object-fit: cover;" onerror="this.src='https://cdn-icons-png.flaticon.com/512/4712/4712035.png'" />
                AI Trợ Lý AiraStore
            </span>
            <i class="fa-solid fa-xmark ai-chat-close" onclick="toggleAIChat()"></i>
        </div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-msg-bubble msg-bot">
                Chào bạn! Mình là Aira - trợ lý ảo của AiraStore. Mình có thể giúp bạn tìm kiếm điện thoại, tư vấn cấu hình, hoặc giải đáp các thắc mắc 24/7. Bạn cần hỗ trợ gì ạ?
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Hỏi Aira tư vấn..." onkeypress="handleAIKeyPress(event)" autocomplete="off" />
            <button onclick="sendAIMessage()"><i class="fa-solid fa-paper-plane"></i></button>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- KHU VỰC NÚT NỔI ĐIỂM DANH & NHÃN HÃY THỬ NGAY (GÓC DƯỚI TRÁI) -->
    <!-- ======================================================== -->
    <div class="floating-checkin-wrapper no-print">
        <button class="floating-checkin-btn" onclick="openDailyCheckInModal()">
            <i class="fa-solid fa-calendar-check"></i>
            <span>Điểm Danh Nhận Điểm</span>
        </button>
        <a href="@Url.Action("MiniGame", "TaiKhoan")" class="floating-hand-prompt">
            <i class="fa-solid fa-hand-point-left"></i> Hãy thử ngay Mini Game!
        </a>
    </div>

    <!-- POPUP ĐIỂM DANH TÍCH LŨY 7 NGÀY LIÊN TỤC -->
    <div id="dailyCheckInModal" class="checkin-modal-overlay no-print">
        <div class="checkin-modal-card">
            <div class="checkin-header">
                <i class="fa-solid fa-xmark checkin-close" onclick="closeDailyCheckInModal()"></i>
                <h3><i class="fa-solid fa-gift" style="color: #FFD700;"></i> Điểm Danh Tích Lũy 7 Ngày</h3>
                <p>Điểm danh liên tục mỗi ngày để nhận tối đa điểm thưởng! (Bỏ lỡ 1 ngày sẽ quay về Thứ 2)</p>
            </div>
            <div class="checkin-body">
                <div class="streak-grid" id="streakGridContainer">
                    <!-- JS tự động render 7 mốc Thứ 2 -> Chủ Nhật -->
                </div>
                <div id="checkinStatusText" style="margin-bottom: 15px; font-size: 14px; font-weight: 700; color: #28a745;"></div>
                <button type="button" id="btnClaimDaily" class="btn-claim-checkin" onclick="claimDailyPoints()">
                    ĐIỂM DANH NHẬN ĐIỂM NGAY
                </button>
            </div>
        </div>
    </div>

    <script>
        // ========================================================
        // JS XỬ LÝ DROPDOWN GỢI Ý TÌM KIẾM (AUTO-SUGGEST)
        // ========================================================
        let timKiemTimeout = null;

        function goiYTimKiemSmart() {
            const tuKhoa = document.getElementById('txtSearchMain').value.trim();
            const suggestBox = document.getElementById('search-suggest-box');

            if (tuKhoa.length < 1) {
                suggestBox.style.display = 'none';
                return;
            }

            clearTimeout(timKiemTimeout);
            timKiemTimeout = setTimeout(() => {
                fetch(`/Home/GoiYTimKiem?tuKhoa=${encodeURIComponent(tuKhoa)}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.length > 0) {
                            let html = `<div class="suggest-header"><i class="fa-solid fa-fire" style="color:#D70018;"></i> Có phải bạn muốn tìm</div>`;
                            data.forEach(item => {
                                let price = item.GiaBan.toLocaleString('vi-VN') + 'đ';
                                html += `
                                                <a href="/Home/Details/${item.MaSP}" class="suggest-item">
                                                    <img src="${item.HinhAnh}" class="suggest-img" onerror="this.src='https://via.placeholder.com/50'"/>
                                                    <div class="suggest-info">
                                                        <span class="suggest-name">${item.TenSP}</span>
                                                        <span class="suggest-price">${price}</span>
                                                    </div>
                                                </a>
                                            `;
                            });
                            suggestBox.innerHTML = html;
                            suggestBox.style.display = 'block';
                        } else {
                            suggestBox.innerHTML = `<div style="padding: 15px; text-align: center; color: #666;"><i class="fa-solid fa-face-frown"></i> Không tìm thấy kết quả nào cho "${tuKhoa}"</div>`;
                            suggestBox.style.display = 'block';
                        }
                    })
                    .catch(err => console.log('Lỗi lấy gợi ý:', err));
            }, 300);
        }

        document.addEventListener('click', function (e) {
            const suggestBox = document.getElementById('search-suggest-box');
            const searchInput = document.getElementById('txtSearchMain');
            if (e.target !== searchInput && !suggestBox.contains(e.target)) {
                suggestBox.style.display = 'none';
            }
        });

        document.getElementById('txtSearchMain').addEventListener('focus', function () {
            if (this.value.trim().length > 0) {
                goiYTimKiemSmart();
            }
        });

        window.onscroll = function () { checkScrollPosition() };

        function checkScrollPosition() {
            var btnTop = document.getElementById("btnScrollTop");
            if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
                btnTop.style.display = "flex";
            } else {
                btnTop.style.display = "none";
            }
        }

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ========================================================
        // JS XỬ LÝ CHAT AI (ẨN/HIỆN POPUP KHI MỞ CHAT)
        // ========================================================
        function toggleAIChat() {
            const chatBox = document.getElementById('aiChatBox');
            const tooltip = document.getElementById('aiTooltipPopup');

            if (chatBox.style.display === 'flex') {
                chatBox.style.display = 'none';
                if (tooltip) tooltip.style.display = 'flex';
            } else {
                chatBox.style.display = 'flex';
                if (tooltip) tooltip.style.display = 'none';
                document.getElementById('aiChatInput').focus();
            }
        }

        function handleAIKeyPress(e) {
            if (e.key === 'Enter') {
                sendAIMessage();
            }
        }

        function sendAIMessage() {
            const inputField = document.getElementById('aiChatInput');
            const message = inputField.value.trim();
            if (!message) return;

            appendAIMessage(message, 'user');
            inputField.value = '';

            const typingId = 'typing-' + Date.now();
            appendAIMessage('<i class="fa-solid fa-ellipsis fa-fade"></i> Trợ lý đang suy nghĩ...', 'bot', typingId);

            fetch('/Home/TuVanAI', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cauHoi: message })
            })
                .then(response => response.json())
                .then(data => {
                    document.getElementById(typingId).remove();

                    if (data.success) {
                        appendAIMessage(data.answer, 'bot');
                        if (data.products && data.products.length > 0) {
                            data.products.forEach(sp => {
                                appendProductCard(sp);
                            });
                        }
                    } else {
                        appendAIMessage('Xin lỗi, hệ thống AI đang bận. Bạn vui lòng thử lại sau nhé!', 'bot');
                    }
                })
                .catch(error => {
                    document.getElementById(typingId).remove();
                    appendAIMessage('Kết nối đến máy chủ thất bại. Vui lòng kiểm tra lại mạng.', 'bot');
                });
        }

        function appendAIMessage(text, sender, elementId = '') {
            const chatBody = document.getElementById('aiChatBody');
            const div = document.createElement('div');
            div.className = `ai-msg-bubble msg-${sender}`;
            if (elementId) div.id = elementId;
            div.innerHTML = text.replace(/\n/g, '<br/>');
            chatBody.appendChild(div);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        function appendProductCard(product) {
            const chatBody = document.getElementById('aiChatBody');
            const a = document.createElement('a');
            a.className = 'ai-product-card msg-bot';
            a.href = `/Home/Details/${product.MaSP}`;

            const price = product.GiaBan.toLocaleString('vi-VN') + 'đ';

            a.innerHTML = `
                        <img src="${product.HinhAnh}" class="ai-product-img" onerror="this.src='https://via.placeholder.com/50'" />
                        <div class="ai-product-info">
                            <span class="ai-product-name">${product.TenSP}</span>
                            <span class="ai-product-price">${price}</span>
                        </div>
                        <i class="fa-solid fa-chevron-right" style="color: #ccc; font-size: 12px; margin-left: 5px;"></i>
                    `;

            chatBody.appendChild(a);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        // ========================================================
        // JS XỬ LÝ POPUP ĐIỂM DANH TÍCH LŨY 7 NGÀY LIÊN TỤC
        // ========================================================
        const scheduleDays = [
            { step: 1, name: "Thứ 2", pts: 10 },
            { step: 2, name: "Thứ 3", pts: 10 },
            { step: 3, name: "Thứ 4", pts: 10 },
            { step: 4, name: "Thứ 5", pts: 15 },
            { step: 5, name: "Thứ 6", pts: 15 },
            { step: 6, name: "Thứ 7", pts: 20 },
            { step: 7, name: "Chủ Nhật (Đặc Biệt)", pts: 20 }
        ];

        function openDailyCheckInModal() {
            const modal = document.getElementById('dailyCheckInModal');
            modal.style.display = 'flex';
            loadCheckInStatus();
        }

        function closeDailyCheckInModal() {
            document.getElementById('dailyCheckInModal').style.display = 'none';
        }

        function loadCheckInStatus() {
            fetch('/TaiKhoan/TrangThaiDiemDanh')
                .then(res => res.json())
                .then(data => {
                    const grid = document.getElementById('streakGridContainer');
                    const btn = document.getElementById('btnClaimDaily');
                    const msg = document.getElementById('checkinStatusText');

                    if (!data.loggedIn) {
                        grid.innerHTML = scheduleDays.map(d => `
                                        <div class="streak-day-box ${d.step === 7 ? 'day-sunday' : ''}">
                                            <span class="day-label">${d.name}</span>
                                            <i class="fa-solid fa-coins" style="color:#ffc107; font-size:20px;"></i>
                                            <span class="day-pts">+${d.pts} điểm</span>
                                        </div>
                                    `).join('');
                        msg.style.color = '#D70018';
                        msg.innerText = 'Vui lòng đăng nhập tài khoản để bắt đầu chuỗi điểm danh!';
                        btn.onclick = function () { window.location.href = '/TaiKhoan/DangNhap'; };
                        btn.innerText = 'ĐĂNG NHẬP ĐỂ NHẬN ĐIỂM';
                        btn.disabled = false;
                        return;
                    }

                    grid.innerHTML = scheduleDays.map(d => {
                        let cls = d.step === 7 ? 'day-sunday ' : '';
                        let icon = '<i class="fa-solid fa-coins" style="color:#ffc107; font-size:20px;"></i>';
                        if (d.step <= data.streak) {
                            cls += 'claimed';
                            icon = '<i class="fa-solid fa-circle-check" style="color:#D70018; font-size:20px;"></i>';
                        } else if (!data.checkedInToday && d.step === data.nextDayStep) {
                            cls += 'today-target';
                        }
                        return `
                                        <div class="streak-day-box ${cls}">
                                            <span class="day-label">${d.name}</span>
                                            ${icon}
                                            <span class="day-pts">+${d.pts} điểm</span>
                                        </div>
                                    `;
                    }).join('');

                    if (data.checkedInToday) {
                        btn.disabled = true;
                        btn.innerText = 'HÔM NAY BẠN ĐÃ ĐIỂM DANH RỒI';
                        msg.style.color = '#28a745';
                        msg.innerText = `Chuỗi hiện tại: ${data.streak}/7 ngày liên tục | Ví điểm: ${data.currentPoints} điểm`;
                    } else {
                        btn.disabled = false;
                        btn.innerText = `NHẬN NGAY +${scheduleDays[data.nextDayStep - 1].pts} ĐIỂM (${scheduleDays[data.nextDayStep - 1].name})`;
                        btn.onclick = claimDailyPoints;
                        msg.style.color = '#e65100';
                        msg.innerText = `Mốc hôm nay: ${scheduleDays[data.nextDayStep - 1].name} | Ví điểm hiện tại: ${data.currentPoints} điểm`;
                    }
                });
        }

        function claimDailyPoints() {
            const btn = document.getElementById('btnClaimDaily');
            btn.disabled = true;
            btn.innerText = 'ĐANG XỬ LÝ...';

            fetch('/TaiKhoan/NhanDiemDanhHangNgay', { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    alert(data.message);
                    loadCheckInStatus();
                    const walletEl = document.getElementById('lblCurrentPoints');
                    if (walletEl && data.newPoints !== undefined) {
                        walletEl.innerText = data.newPoints;
                    }
                });
        }

        // ========================================================
        // TÍCH HỢP LORDICON CHO TOÀN BỘ HEADER (BẰNG JAVASCRIPT)
        // ========================================================
        document.addEventListener("DOMContentLoaded", () => {
            function replaceWithLordIcon(selector, srcUrl, width = '24px', colors = 'primary:#ffffff,secondary:#ffffff') {
                const icon = document.querySelector(selector);
                if (icon) {
                    const wrapper = icon.parentElement;
                    const lordIcon = document.createElement('lord-icon');
                    lordIcon.setAttribute('src', srcUrl);
                    lordIcon.setAttribute('trigger', 'hover');
                    lordIcon.setAttribute('colors', colors);
                    lordIcon.style.width = width;
                    lordIcon.style.height = width;

                    wrapper.replaceChild(lordIcon, icon);
                }
            }

            try {
                // 1. Giỏ hàng (Túi mua sắm nảy lên)
                replaceWithLordIcon('.header-items .fa-cart-shopping', 'https://cdn.lordicon.com/cllunfud.json');

                // 2. Yêu thích (Trái tim đập thình thịch)
                replaceWithLordIcon('.header-items .fa-heart', 'https://cdn.lordicon.com/rjzlnunf.json');

                // 3. Tin tức (Tờ báo lật trang)
                replaceWithLordIcon('.header-items .fa-newspaper', 'https://cdn.lordicon.com/sygggnra.json');

            } catch (error) {
                console.warn("Lordicon Load Failed - Using default fallback icons.");
            }
        });
    </script>

    <!-- THÊM DÒNG NÀY ĐỂ NHẬN CODE TỪ TRANG SO SÁNH -->
    @RenderSection("scripts", required: false)

</body>
</html>